# PostgreSQL 数据库连接配置
# 复制此文件为 .env 并修改配置：cp .env.example .env

# 本地开发环境（默认配置）
# 格式：postgresql://username:password@host:port/database?schema=public
DATABASE_URL="postgresql://postgres:your_password_here@localhost:5432/weroam?schema=public"

# 参数说明：
# - postgres -> 用户名（默认）
# - your_password_here -> 密码（请修改为你的 PostgreSQL 密码）
# - localhost:5432 -> 主机:端口
# - weroam -> 数据库名称
# - schema=public -> PostgreSQL schema

# 如果使用 Docker 或其他配置，请相应修改上面的连接字符串

# 云数据库示例：
# Supabase:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.xxxx.supabase.co:5432/postgres"

# Neon:
# DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require"

# Railway:
# DATABASE_URL="postgresql://postgres:password@containers-us-west-xxx.railway.app:5432/railway"

# Qwen API 配置 (用于 AI 行程规划)
QWEN_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
QWEN_API_ENDPOINT="https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions"
